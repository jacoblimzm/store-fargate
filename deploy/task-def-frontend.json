{
  "family": "pay2play-frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "pidMode": "task",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${EXECUTION_ROLE_NAME}",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${TASK_ROLE_NAME}",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/pay2play-frontend:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [{ "containerPort": 80, "protocol": "tcp" }],
      "environment": [
        { "name": "BACKEND_HOST", "value": "backend" },
        { "name": "BACKEND_PORT", "value": "8000" }
      ],
      "logConfiguration": {
        "logDriver": "awsfirelens",
        "options": {
          "Name": "datadog",
          "Host": "http-intake.logs.${DD_SITE}",
          "TLS": "on",
          "provider": "ecs",
          "dd_service": "pay2play-frontend",
          "dd_source": "nginx",
          "dd_message_key": "log",
          "dd_tags": "env:${DD_ENV}"
        },
        "secretOptions": [
          { "name": "apikey", "valueFrom": "${DD_API_KEY_SECRET_ARN}" }
        ]
      }
    },
    {
      "name": "datadog-agent",
      "image": "public.ecr.aws/datadog/agent:latest",
      "essential": true,
      "environment": [
        { "name": "DD_SITE", "value": "${DD_SITE}" },
        { "name": "ECS_FARGATE", "value": "true" },
        { "name": "DD_APM_ENABLED", "value": "true" },
        { "name": "DD_APM_RECEIVER_SOCKET", "value": "/var/run/datadog/apm.socket" },
        { "name": "DD_DOGSTATSD_SOCKET", "value": "/var/run/datadog/dsd.socket" },
        { "name": "DD_PROCESS_AGENT_ENABLED", "value": "true" },
        { "name": "DD_ENV", "value": "${DD_ENV}" },
        { "name": "DD_SYSTEM_PROBE_NETWORK_ENABLED", "value": "true" },
        { "name": "DD_NETWORK_CONFIG_ENABLE_EBPFLESS", "value": "true" }
      ],
      "secrets": [
        { "name": "DD_API_KEY", "valueFrom": "${DD_API_KEY_SECRET_ARN}" }
      ],
      "mountPoints": [
        { "containerPath": "/var/run/datadog", "sourceVolume": "dd-sockets" }
      ],
      "linuxParameters": {
        "capabilities": {
          "add": ["SYS_PTRACE"]
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "agent health"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pay2play-frontend",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "datadog-agent",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "log_router",
      "image": "public.ecr.aws/aws-observability/aws-for-fluent-bit:stable",
      "essential": true,
      "firelensConfiguration": {
        "type": "fluentbit",
        "options": {
          "enable-ecs-log-metadata": "true"
        }
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pay2play-frontend",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "log-router",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "volumes": [{ "name": "dd-sockets" }]
}
