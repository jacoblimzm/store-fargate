# Copy to deploy/deploy.env and fill in the values captured during setup.
# The deploy scripts (ecr-push.sh, deploy-service.sh, deploy.sh) auto-source
# deploy/deploy.env if it exists, so you don't have to re-export in every shell.
#
#   cp deploy/deploy.env.example deploy/deploy.env
#   # edit deploy/deploy.env, then just run:
#   ./deploy/ecr-push.sh && ./deploy/deploy-service.sh
#
# deploy/deploy.env is gitignored (it holds account IDs + secret ARNs).

# --- Account / region ---
export AWS_ACCOUNT_ID=123456789012
export AWS_REGION=ap-southeast-1

# --- ECS / networking (from steps 4-6) ---
export ECS_CLUSTER=pay2playcluster
export SUBNETS=subnet-aaaa,subnet-bbbb          # >=2 AZs, comma-separated
export SECURITY_GROUP_ID=sg-task                # the task SG (inbound 80 from ALB SG)
export TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:ap-southeast-1:123456789012:targetgroup/pay2play-tg/xxxx

# --- Secrets (ARNs, from step 2) ---
export DD_API_KEY_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:pay2play/dd-api-key-xxxxxx
export DB_PASSWORD_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:pay2play/db-password-xxxxxx
export JWT_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:pay2play/jwt-secret-xxxxxx

# --- IAM role names (only if you prefixed them in step 3) ---
export EXECUTION_ROLE_NAME=ecsTaskExecutionRole
export TASK_ROLE_NAME=pay2playTaskRole

# --- Optional knobs (defaults shown) ---
export IMAGE_TAG=latest
export DD_SITE=datadoghq.com
export DD_ENV=demo
# export SERVICE_NAME=pay2play
# export DESIRED_COUNT=1
