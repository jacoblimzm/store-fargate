# Copy to .env and adjust values. Do NOT commit your real .env.

# --- Postgres ---
POSTGRES_USER=pay2play
POSTGRES_PASSWORD=pay2play_local_pw
POSTGRES_DB=pay2play

# --- Backend ---
# Secret used to sign JWTs. Use a long random string in real environments.
JWT_SECRET=change-me-local-dev-secret
# Access token lifetime in minutes.
JWT_EXP_MINUTES=60
# Seed demo users/accounts/transactions on startup (idempotent).
SEED_ON_START=true

# --- Datadog (Phase 2) ---
# DD_API_KEY=your-datadog-api-key
# DD_SITE=datadoghq.com
